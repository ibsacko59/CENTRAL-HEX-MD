});

// ==================== COMMANDE CLOSE ====================
this.commands.set("close", {
  name: "close",
  description: "Ferme le groupe (admins seulement)",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return sock.sendMessage(from, { text: "❌ Groupe uniquement" });
    }

