// ==================== SHIMMERS ====================
this.commands.set("shimmers", {
  name: "shimmers",
  description: "Effet shimmer sur un texte",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const text = args.join(" ");
    if (!text) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .shimmers [texte]");
    }

    const shimmerChars = ["✨", "🌟", "💫", "⭐", "🔥", "💥", "🌈"];
    const randomEmoji = () => shimmerChars[Math.floor(Math.random() * shimmerChars.length)];

    const shimmerText = text.split("").map(c => c === " " ? " " : c).join("");
    const decorated = `${randomEmoji()} ${shimmerText} ${randomEmoji()}\n${randomEmoji()}${randomEmoji()}${randomEmoji()}`;

    await sendWithChannelButton(sock, from, decorated);
  }
});

