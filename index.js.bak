// ==================== JOIN ====================
this.commands.set("join", {
  name: "join",
  description: "Rejoindre un groupe via lien",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const link = args[0];
    if (!link || !link.includes("chat.whatsapp.com")) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .join https://chat.whatsapp.com/xxxxx");
    }

    const code = link.split("chat.whatsapp.com/")[1]?.split(" ")[0];
    if (!code) {
      return await sendWithChannelButton(sock, from, "❌ Lien invalide");
    }

    try {
      await sock.groupAcceptInvite(code);
      await sendWithChannelButton(sock, from, `✅ Bot a rejoint le groupe via le lien !`);
    } catch (err) {
      await sendWithChannelButton(sock, from, `❌ Impossible de rejoindre: ${err.message}`);
    }
  }
});

