});

// ==================== COMMANDE ANTILINK ====================
this.commands.set("antilink", {
  name: "antilink",
  description: "Active ou désactive antilink",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return sock.sendMessage(from, { text: "❌ Groupe uniquement" });
    }

    const option = args[0];

    if (!option || !["on", "off"].includes(option)) {
      return sock.sendMessage(from, { text: "❌ Usage: .antilink on/off" });
    }

    const configPath = "./antilink.json";
    let data = {};

    if (fs.existsSync(configPath)) {
      data = JSON.parse(fs.readFileSync(configPath));
    }

    data[from] = option === "on";
    fs.writeFileSync(configPath, JSON.stringify(data, null, 2));

    await sendWithChannelButton(sock, from,
      `🔗 Antilink ${option === "on" ? "activé" : "désactivé"}`
    );
  }
});

