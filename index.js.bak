// ==================== STICKER ====================
this.commands.set("sticker", {
  name: "sticker",
  description: "Créer un sticker depuis une image/vidéo",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;

    const quoted = msg.message?.extendedTextMessage?.contextInfo?.quotedMessage;
    if (!quoted) {
      return await sendWithChannelButton(sock, from,
        "❌ Réponds à une image ou vidéo pour créer un sticker\n\nEx: Réponds à une image avec .sticker"
      );
    }

    const imageMsg = quoted?.imageMessage;
    const videoMsg = quoted?.videoMessage;

    if (!imageMsg && !videoMsg) {
      return await sendWithChannelButton(sock, from, "❌ Réponds à une image ou vidéo");
    }

    try {
      await sendWithChannelButton(sock, from, "⏳ Création du sticker en cours...");

      if (imageMsg) {
        const stream = await downloadContentFromMessage(imageMsg, "image");
        let buffer = Buffer.from([]);
        for await (const chunk of stream) {
          buffer = Buffer.concat([buffer, chunk]);
        }

        await sock.sendMessage(from, {
          sticker: buffer
        });
      } else {
        await sendWithChannelButton(sock, from, "⚠️ Les vidéos nécessitent ffmpeg. Utilisez une image.");
      }
    } catch (err) {
      await sendWithChannelButton(sock, from, `❌ Erreur création sticker: ${err.message}`);
    }
  }
});

