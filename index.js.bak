// ==================== KICK ====================
this.commands.set("kick", {
  name: "kick",
  description: "Exclure un membre du groupe",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const target = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0];
    if (!target) {
      return await sendWithChannelButton(sock, from, "❌ Mentionne la personne à kicker\nEx: .kick @user");
    }

    try {
      await sock.groupParticipantsUpdate(from, [target], "remove");
      await sendWithChannelButton(sock, from,
        `👢 *KICK*\n\n@${target.split("@")[0]} a été exclu du groupe.`,
        [target]
      );
    } catch (err) {
      await sendWithChannelButton(sock, from, "❌ Erreur lors du kick. Le bot doit être admin.");
    }
  }
});

