// ✅ Création automatique du fichier antipurge.js
const ANTIPURGE_PATH = path.join(COMMANDS_FOLDER, 'antipurge.js');
if (!fs.existsSync(ANTIPURGE_PATH)) {
  console.log(`${colors.yellow}📝 Création du fichier antipurge.js...${colors.reset}`);
  
  const antipurgeContent = `// Commande antipurge - Protection contre les purges
module.exports = {
  name: "antipurge",
  description: "Active la protection contre les purges",
  category: "admin",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;
    
    if (!from.endsWith('@g.us')) {
      return await sock.sendMessage(from, { text: "❌ Cette commande fonctionne uniquement dans les groupes." });
    }
    
    const groupMetadata = await sock.groupMetadata(from);
    const participant = groupMetadata.participants.find(p => p.id === sender);
    
    if (!participant || !['admin', 'superadmin'].includes(participant.admin)) {
      return await sock.sendMessage(from, { text: "❌ Seuls les admins peuvent utiliser cette commande." });
    }
    
    const option = args[0]?.toLowerCase();
    
    if (option === 'on') {
      await sock.sendMessage(from, { text: "🛡️ *ANTIPURGE ACTIVÉ* - La protection est maintenant active." });
    } else if (option === 'off') {
      await sock.sendMessage(from, { text: "🛡️ *ANTIPURGE DÉSACTIVÉ* - La protection est désactivée." });
    } else {
      await sock.sendMessage(from, { 
        text: "📋 *ANTIPURGE*\n\nUtilisation:\n• .antipurge on - Activer\n• .antipurge off - Désactiver\n\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻𝙴-𝙷𝙴𝚇"
      });
    }
  }
};`;
  
  fs.writeFileSync(ANTIPURGE_PATH, antipurgeContent);
  console.log(`${colors.green}✅ Fichier antipurge.js créé avec succès${colors.reset}`);
}

