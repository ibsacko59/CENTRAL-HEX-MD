this.commands.set("setppgc", {
  name: "setppgc",
  description: "Changer la photo du groupe",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const quoted = msg.message?.extendedTextMessage?.contextInfo?.quotedMessage?.imageMessage;
    if (!quoted) {
      return await sendWithChannelButton(sock, from, "❌ Réponds à une image pour changer la photo du groupe");
    }

    try {
      const buffer = await sock.downloadMediaMessage({ message: { imageMessage: quoted } });
      await sock.updateProfilePicture(from, buffer);
      await sendWithChannelButton(sock, from, "🖼️ Photo du groupe changée avec succès !");
    } catch (err) {
      await sendWithChannelButton(sock, from, "❌ Erreur changement photo. Le bot doit être admin.");
    }
  }
});

