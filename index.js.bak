// ==================== COMMANDE BLOCK ====================
this.commands.set("ibblock", {
  name: "ibblock",
  category: "owner",
  async execute(sock, msg) {

    const sender = msg.key.participant || msg.key.remoteJid
    const from = msg.key.remoteJid

    if (!isOwner(sender))
      return sock.sendMessage(from, { text: "❌ Owner seulement." })

    const target = msg.message?.extendedTextMessage?.contextInfo?.participant
    if (!target)
      return sock.sendMessage(from, { text: "❌ Mentionne la personne." })

    await sock.updateBlockStatus(target, "block")

    sock.sendMessage(from, { text: "🚫 Utilisateur bloqué." })
  }
})

