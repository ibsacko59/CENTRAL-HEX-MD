    // ==================== COMMANDE TAGADMIN ====================
    this.commands.set("tagadmin", {
      name: "tagadmin",
      description: "Mentionne tous les admins du groupe",
      execute: async (sock, msg, args) => {
        const from = msg.key.remoteJid;

        if (!from.endsWith("@g.us")) {
          return await sendWithChannelButton(sock, from, "❌ Cette commande fonctionne uniquement dans les groupes");
        }

        try {
          const metadata = await getGroupMetadata(sock, from);
          const participants = metadata.participants || [];

          const admins = participants.filter(p => p.admin === "admin" || p.admin === "superadmin");
          if (admins.length === 0) {
            return await sendWithChannelButton(sock, from, "❌ Aucun admin trouvé dans le groupe");
          }

          let text = `📣 Mention des admins :\n\n`;
          const mentions = [];

          for (const admin of admins) {
            text += `➤ @${admin.id.split("@")[0]}\n`;
            mentions.push(admin.id);
          }

          text += `\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻𝙴-𝙷𝙴𝚇`;

          await sendWithChannelButton(sock, from, text, mentions);

        } catch (err) {
          console.log("tagadmin error:", err);
          await sendWithChannelButton(sock, from, "❌ Impossible de récupérer les admins");
        }
      },
    });
    
    
// ==================== COMMANDE VV ====================
const viewOnceStore = require('../store/viewOnceStore');
const sendWithChannelButton = require('../utils/sendWithChannelButton');

module.exports = {
  name: "vv",
  description: "Affiche la dernière vue unique sauvegardée",
  
  execute: async (sock, msg, args) => {
    try {
      const from = msg.key.remoteJid;
      
      // Vérifier si le message vient d'un groupe
      const isGroup = from.endsWith('@g.us');
      
      if (!from) {
        await sock.sendMessage(from, { text: "❌ Erreur: Impossible d'identifier le chat" });
        return;
      }

      // Récupérer les données VV pour ce chat
      const data = viewOnceStore.get(from);

      if (!data) {
        await sendWithChannelButton(sock, from, "❌ Aucune vue unique sauvegardée pour ce chat");
        return;
      }

      // Vérifier si les données sont valides
      if (!data.buffer && !data.url) {
        await sock.sendMessage(from, { text: "❌ Données de vue unique corrompues ou expirées" });
        // Nettoyer les données corrompues
        viewOnceStore.delete(from);
        return;
      }

      // Envoyer le média selon son type
      if (data.type === 'image') {
        await sock.sendMessage(from, {
          image: data.buffer,
          caption: data.caption || '📸 Vue unique sauvegardée',
          mimetype: 'image/jpeg'
        });
      } 
      else if (data.type === 'video') {
        await sock.sendMessage(from, {
          video: data.buffer,
          caption: data.caption || '🎥 Vue unique sauvegardée',
          mimetype: 'video/mp4'
        });
      }
      else if (data.type === 'audio') {
        await sock.sendMessage(from, {
          audio: data.buffer,
          mimetype: 'audio/mp4',
          ptt: data.ptt || false // Pour les messages vocaux
        });
      }
      else {
        // Fallback pour les autres types
        await sock.sendMessage(from, { 
          text: `📎 Vue unique (${data.type || 'inconnu'}) - Impossible d'afficher directement` 
        });
      }

      console.log(`✅ VV affichée pour ${from} - Type: ${data.type}`);

    } catch (error) {
      console.error("❌ Erreur dans la commande vv:", error);
      try {
        await sock.sendMessage(from, { 
          text: "❌ Erreur lors de l'affichage de la vue unique" 
        });
      } catch (e) {
        console.error("Impossible d'envoyer le message d'erreur:", e);
      }
    }
  }
};

    // ==================== COMMANDE FAKERECORDING ====================
    this.commands.set("fakerecording", {
      name: "fakerecording",
      description: "Active ou désactive le fake recording",
      execute: async (sock, msg, args) => {
        const from = msg.key.remoteJid;
        const sender = msg.key.participant || msg.key.remoteJid;
        
        if (!isOwner(sender)) {
          return await sendWithChannelButton(sock, from, "❌ Commande réservée au propriétaire");
        }
        
        const option = args[0]?.toLowerCase();
        if (option === 'on') {
          fakeRecording = true;
          config.fakeRecording = true;
          fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
          await sendWithChannelButton(sock, from, "🎤 *FAKE RECORDING ACTIVÉ*");
        } else if (option === 'off') {
          fakeRecording = false;
          config.fakeRecording = false;
          fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
          await sendWithChannelButton(sock, from, "🎤 *FAKE RECORDING DÉSACTIVÉ*");
        } else {
          await sendWithChannelButton(sock, from, `📋 *FAKE RECORDING*\n\nStatut: ${fakeRecording ? 'Activé' : 'Désactivé'}\n\nUsage:\n• .fakerecording on\n• .fakerecording off`);
        }
      }
    });

