  description: "Config de l'application bot",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const sub = args[0]?.toLowerCase();
    if (!sub) {
      return await sendWithChannelButton(sock, from,
        `⚙️ *SETAPP*\n\nUsage:\n• .setapp name [nom]\n• .setapp img [url]\n• .setapp channel [url]`
      );
    }

    if (sub === "name") {
      config.channelName = args.slice(1).join(" ");
      fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
      await sendWithChannelButton(sock, from, `✅ Nom de la chaîne: ${config.channelName}`);
    } else if (sub === "img") {
      config.botImageUrl = args[1];
      fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
      await sendWithChannelButton(sock, from, "✅ Image bot mise à jour");
    } else if (sub === "channel") {
      config.telegramLink = args[1];
      fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
      await sendWithChannelButton(sock, from, `✅ Canal: ${config.telegramLink}`);
    }
  }
});

