    this.commands.set("welcome", {
      name: "welcome",
      description: "Active ou désactive le message de bienvenue",
      execute: async (sock, msg, args) => {
        const from = msg.key.remoteJid;

        try {
          if (args[0] === "on") {
            welcomeEnabled = true;
            return await sendWithChannelButton(sock, from, "✅ Messages de bienvenue activés");
          } else if (args[0] === "off") {
            welcomeEnabled = false;
            return await sendWithChannelButton(sock, from, "❌ Messages de bienvenue désactivés");
          }

          if (!welcomeEnabled) {
            return await sendWithChannelButton(sock, from, "❌ La fonctionnalité de bienvenue est désactivée. Tapez `.welcome on` pour l'activer.");
          }

          const mentions = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid || [];
          if (mentions.length === 0) {
            return await sendWithChannelButton(sock, from, "❌ Veuillez mentionner la personne à accueillir\nExemple : .welcome @nom");
          }

          const mentionJid = mentions[0];
          const metadata = await getGroupMetadata(sock, from);
          const groupName = metadata.subject || "Groupe";
          const memberCount = metadata.participants.length;

          const text = `
┏━━━❖ 𝗖𝗘𝗡𝗧𝗥𝗔𝗟-𝗛𝗘𝗫 ❖━━━━┓
┃ Groupe: ${groupName}
┃ Membres: ${memberCount}
┃
┃ @${mentionJid.split('@')[0]}
┃ 
┃ *BIENVENUE PAUVRE MORTEL*
┗━━━━━━━━━━━━━━━━━━┛
          `.trim();

          await sendWithChannelButton(sock, from, text, [mentionJid], botImageUrl);

        } catch (err) {
          console.log("welcome command error:", err);
          await sock.sendMessage(from, { text: "❌ Une erreur est survenue" });
        }
      }
    });

    // ==================== COMMANDE AUTOKICK ====================
    this.commands.set("autokick", {
      name: "autokick",
      description: "Active ou désactive l'autokick pour les nouveaux membres",
      execute: async (sock, msg, args) => {
        const from = msg.key.remoteJid;

        if (!from.endsWith("@g.us")) {
          return await sock.sendMessage(from, { text: "❌ Cette commande fonctionne uniquement dans les groupes" });
        }

        const option = args[0]?.toLowerCase();
        if (!option || !["on", "off"].includes(option)) {
          return await sock.sendMessage(from, { text: "❌ Usage : .autokick on/off" });
        }

        const configPath = path.join('./autokick.json');
        let autokickConfig = {};
        if (fs.existsSync(configPath)) {
          autokickConfig = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
        }
        autokickConfig[from] = option === 'on';
        fs.writeFileSync(configPath, JSON.stringify(autokickConfig, null, 2));

        await sendWithChannelButton(sock, from, `✅ Autokick ${option === 'on' ? 'activé' : 'désactivé'} pour ce groupe`);

        const metadata = await getGroupMetadata(sock, from);
        const knownMembers = new Set(metadata.participants.map(p => p.id));

        sock.ev.on('group-participants.update', async (update) => {
          if (update.id !== from) return;

          if (update.action === 'add') {
            for (const p of update.participants) {
              if (!knownMembers.has(p)) {
                knownMembers.add(p);

                if (autokickConfig[from]) {
                  try {
                    await sock.groupParticipantsUpdate(from, [p], 'remove');
                    await sendWithChannelButton(sock, from, `⚠️ Nouveau membre ${p.split('@')[0]} kické automatiquement`);
                  } catch (err) {
                    console.log("Erreur kick nouveau membre :", err);
                  }
                }
              }
            }
          }
        });
      }
    });

    // ==================== COMMANDE INFO ====================
    this.commands.set("info", {
      name: "info",
      description: "Affiche les informations détaillées du groupe",
      execute: async (sock, msg, args) => {
        const from = msg.key.remoteJid;

        if (!from.endsWith("@g.us")) {
          return await sock.sendMessage(from, { text: "❌ Commande réservée aux groupes" });
