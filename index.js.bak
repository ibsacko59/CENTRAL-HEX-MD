    if (!from.endsWith("@g.us")) return;

    try {
      await sock.groupSettingUpdate(from, "not_announcement");
      await sendWithChannelButton(sock, from, "🔊 Groupe réactivé");
    } catch {
      await sock.sendMessage(from, { text: "❌ Erreur unmute" });
    }
  }
});

