this.commands.set("sudo", {
  name: "sudo",
  description: "Liste des utilisateurs sudo",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sudoList = global.sudoUsers || [];

    if (sudoList.length === 0) {
      return await sendWithChannelButton(sock, from, "📋 *LISTE SUDO*\n\nAucun utilisateur sudo.");
    }

    let text = `📋 *LISTE SUDO*\n\n`;
    for (const uid of sudoList) {
      text += `• @${uid.split("@")[0]}\n`;
    }
    text += `\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`;

    await sendWithChannelButton(sock, from, text, sudoList);
  }
});

// ==================== SUDOADD ====================
this.commands.set("sudoadd", {
  name: "sudoadd",
  description: "Ajouter un utilisateur sudo",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const target = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0];
    if (!target) {
      return await sendWithChannelButton(sock, from, "❌ Mentionne l'utilisateur à ajouter en sudo");
    }

    if (!global.sudoUsers) global.sudoUsers = [];
    if (!global.sudoUsers.includes(target)) {
      global.sudoUsers.push(target);
    }

    await sendWithChannelButton(sock, from,
      `✅ @${target.split("@")[0]} ajouté aux sudo !`,
      [target]
    );
  }
});

