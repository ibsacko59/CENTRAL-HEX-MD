this.commands.set("hextech", {
  name: "hextech",
  description: "Informations techniques",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const mem = process.memoryUsage();
    const memMB = Math.round(mem.rss / 1024 / 1024);
    const uptimeMs = Date.now() - BOT_START_TIME;
    const h = Math.floor(uptimeMs / 3600000);
    const m = Math.floor((uptimeMs % 3600000) / 60000);

    await sendWithChannelButton(sock, from,
      `🔬 *CENTRAL-HEX INFO*\n\n` +
      `┌─────────────────\n` +
      `│ 🤖 Bot: CENTRAL-HEX\n` +
      `│ ⚙️ Node: ${process.version}\n` +
      `│ 📦 Platform: ${process.platform}\n` +
      `│ 💾 RAM: ${memMB} MB\n` +
      `│ ⏱️ Uptime: ${h}h ${m}m\n` +
      `│ 📊 Messages en cache: ${messageStore.size}\n` +
      `└─────────────────\n\n` +
      `> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`
    );
  }
});

// ==================== HACK ====================
this.commands.set("hack", {
  name: "hack",
  description: "Effet hack animé",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const target = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0];
    const targetName = target ? `@${target.split("@")[0]}` : (args[0] || "la cible");

    const hackLines = [
      `💻 *HACK CENTRAL-HEX*\n\n🔍 Initialisation...\n[██░░░░░░░░] 20%`,
      `💻 *HACK CENTRAL-HEX*\n\n🔍 Scan IP...\n[████░░░░░░] 40%`,
      `💻 *HACK CENTRAL-HEX*\n\n🔓 Bypass firewall...\n[██████░░░░] 60%`,
      `💻 *HACK CENTRAL-HEX*\n\n📂 Accès données...\n[████████░░] 80%`,
      `💻 *HACK CENTRAL-HEX*\n\n✅ HACK RÉUSSI !\n[██████████] 100%\n\n👤 Cible: ${targetName}\n📍 Localisation: Inconnue\n\n> *⚠️ Ceci est une simulation - Pour rire !*`
    ];

    const sentMsg = await sock.sendMessage(from, { text: hackLines[0] });
    for (let i = 1; i < hackLines.length; i++) {
      await new Promise(r => setTimeout(r, 1200));
      await sock.sendMessage(from, { text: hackLines[i], edit: sentMsg.key });
    }
  }
});

// ==================== ASCII ====================
this.commands.set("ascii", {
  name: "ascii",
  description: "Convertit du texte en ASCII stylé",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const text = args.join(" ");

    if (!text) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .ascii [texte]");
    }

    const asciiMap = {
      'a':'𝒶','b':'𝒷','c':'𝒸','d':'𝒹','e':'𝑒','f':'𝒻','g':'𝑔','h':'𝒽','i':'𝒾',
      'j':'𝒿','k':'𝓀','l':'𝓁','m':'𝓂','n':'𝓃','o':'𝑜','p':'𝓅','q':'𝓆','r':'𝓇',
      's':'𝓈','t':'𝓉','u':'𝓊','v':'𝓋','w':'𝓌','x':'𝓍','y':'𝓎','z':'𝓏',
      'A':'𝒜','B':'𝐵','C':'𝒞','D':'𝒟','E':'𝐸','F':'𝐹','G':'𝒢','H':'𝐻','I':'𝐼',
      'J':'𝒥','K':'𝒦','L':'𝐿','M':'𝑀','N':'𝒩','O':'𝒪','P':'𝒫','Q':'𝒬','R':'𝑅',
      'S':'𝒮','T':'𝒯','U':'𝒰','V':'𝒱','W':'𝒲','X':'𝒳','Y':'𝒴','Z':'𝒵'
    };

    const styled = text.split("").map(c => asciiMap[c] || c).join("");
    await sendWithChannelButton(sock, from, `✨ *ASCII STYLE*\n\n${styled}`);
  }
});

// ==================== AUTHORITY ====================
this.commands.set("authority", {
  name: "authority",
  description: "Afficher les autorités du bot",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    const ownerList = [config.ownerNumber, ...(global.extraOwners || [])];
    const sudoList = global.sudoUsers || [];

    let text = `⚔️ *SYSTÈME D'AUTORITÉ*\n\n`;
    text += `👑 *OWNERS (${ownerList.length}):*\n`;
    for (const o of ownerList) {
      text += `• +${o.replace(/\D/g,'')}\n`;
    }
    text += `\n🔰 *SUDO (${sudoList.length}):*\n`;
    if (sudoList.length === 0) {
      text += `• Aucun sudo\n`;
    } else {
      for (const s of sudoList) {
        text += `• @${s.split("@")[0]}\n`;
      }
    }
    text += `\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`;

    await sendWithChannelButton(sock, from, text, sudoList);
  }
});

// ==================== GETUSER ====================
this.commands.set("getuser", {
  name: "getuser",
  description: "Informations sur un utilisateur",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    let targetJid;

    if (msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0]) {
      targetJid = msg.message.extendedTextMessage.contextInfo.mentionedJid[0];
    } else if (args[0]) {
      targetJid = args[0].replace(/\D/g, "") + "@s.whatsapp.net";
    } else {
      targetJid = msg.key.participant || msg.key.remoteJid;
    }

    try {
      let ppUrl;
      try {
        ppUrl = await sock.profilePictureUrl(targetJid, "image");
      } catch {
        ppUrl = null;
      }

      const text = `👤 *INFO UTILISATEUR*\n\n` +
        `┌─────────────────\n` +
        `│ 📱 Numéro: +${targetJid.split("@")[0]}\n` +
        `│ 🆔 JID: ${targetJid}\n` +
        `│ 🖼️ Photo: ${ppUrl ? "Disponible" : "Privée/Indisponible"}\n` +
        `│ 👑 Owner: ${isOwner(targetJid) ? "Oui" : "Non"}\n` +
        `└─────────────────\n\n` +
        `> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`;

      await sendWithChannelButton(sock, from, text, [targetJid], ppUrl);
    } catch (err) {
      await sendWithChannelButton(sock, from, `❌ Erreur: ${err.message}`);
    }
  }
});

