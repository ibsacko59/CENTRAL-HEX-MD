// ==================== CLOSETIME ====================
this.commands.set("closetime", {
  name: "closetime",
  description: "Fermer le groupe temporairement",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const duration = parseInt(args[0]) || 30;
    const unit = args[1]?.toLowerCase() || "m";

    let durationMs;
    if (unit === "s") durationMs = duration * 1000;
    else if (unit === "h") durationMs = duration * 3600000;
    else durationMs = duration * 60000;

    try {
      await sock.groupSettingUpdate(from, "announcement");
      await sendWithChannelButton(sock, from,
        `🔒 *GROUPE FERMÉ*\n\n⏱️ Durée: ${duration}${unit}\n🔓 Réouverture automatique...`
      );

      setTimeout(async () => {
        try {
          await sock.groupSettingUpdate(from, "not_announcement");
          await sendWithChannelButton(sock, from, "🔓 Groupe réouvert automatiquement !");
        } catch (e) {}
      }, durationMs);
    } catch (err) {
      await sendWithChannelButton(sock, from, "❌ Erreur. Le bot doit être admin.");
    }
  }
});

