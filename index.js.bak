// ==================== TOTALTAG ====================
this.commands.set("totaltag", {
  name: "totaltag",
  description: "Statistiques totales des tags",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    if (!global.tagCount || global.tagCount.size === 0) {
      return await sendWithChannelButton(sock, from, "📊 *TOTAL TAG*\n\nAucune statistique disponible.");
    }
    let text = `📊 *TOTAL TAGS*\n\n`;
    let sorted = [...global.tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
    const mentions = [];
    for (const [uid, count] of sorted) {
      text += `• @${uid.split("@")[0]}: ${count} tags\n`;
      mentions.push(uid);
    }
    text += `\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`;
    await sendWithChannelButton(sock, from, text, mentions);
  }
});

// ==================== FILTER ====================
this.commands.set("filter", {
  name: "filter",
  description: "Gestion des filtres de mots",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    if (!global.wordFilters) global.wordFilters = new Map();
    const groupFilters = global.wordFilters.get(from) || [];

    const sub = args[0]?.toLowerCase();

    if (sub === "add") {
      const word = args.slice(1).join(" ");
      if (!word) return await sendWithChannelButton(sock, from, "❌ Usage: .filter add [mot]");
      if (!groupFilters.includes(word)) groupFilters.push(word);
      global.wordFilters.set(from, groupFilters);
      await sendWithChannelButton(sock, from, `✅ Mot filtré ajouté: "${word}"`);

    } else if (sub === "del" || sub === "remove") {
      const word = args.slice(1).join(" ");
      const idx = groupFilters.indexOf(word);
      if (idx > -1) groupFilters.splice(idx, 1);
      global.wordFilters.set(from, groupFilters);
      await sendWithChannelButton(sock, from, `✅ Mot filtré supprimé: "${word}"`);

    } else if (sub === "config" || sub === "list") {
      if (groupFilters.length === 0) {
        return await sendWithChannelButton(sock, from, "📋 *FILTRES*\n\nAucun mot filtré dans ce groupe.");
      }
      await sendWithChannelButton(sock, from,
        `📋 *FILTRES ACTIFS (${groupFilters.length})*\n\n${groupFilters.map((w, i) => `${i+1}. ${w}`).join("\n")}`
      );

    } else {
      await sendWithChannelButton(sock, from,
        `📋 *FILTRE*\n\nUsage:\n• .filter add [mot] - Ajouter\n• .filter del [mot] - Supprimer\n• .filter config - Liste\n\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`
      );
    }
  }
});

