// ==================== COMMANDE SETPPBOT ====================
this.commands.set("ibsetppbot", {
  name: "ibsetppbot",
  category: "owner",
  async execute(sock, msg) {

    const sender = msg.key.participant || msg.key.remoteJid
    const from = msg.key.remoteJid

    if (!isOwner(sender))
      return sock.sendMessage(from, { text: "❌ Owner seulement." })

    const quoted = msg.message?.extendedTextMessage?.contextInfo?.quotedMessage?.imageMessage
    if (!quoted)
      return sock.sendMessage(from, { text: "❌ Répond à une image." })

    const buffer = await sock.downloadMediaMessage({
      message: { imageMessage: quoted }
    })

    await sock.updateProfilePicture(sock.user.id, buffer)

    sock.sendMessage(from, { text: "🖼️ Photo du bot changée." })
  }
})


