this.commands.set("mode", {
  name: "mode",
  description: "Changer le mode public/privé",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const option = args[0]?.toLowerCase();
    if (!option || !["public", "private", "prive"].includes(option)) {
      return await sendWithChannelButton(sock, from, `❌ Usage: .mode public/private\n\nMode actuel: ${botPrivé ? "Public" : "Privé"}`);
    }

    if (option === "privé") {
      botPublic = true;
      config.botPublic = true;
    } else {
      botPublic = false;
      config.botPublic = false;
    }

    fs.writeFileSync('./config.json', JSON.stringify(config, null, 2));
    await sendWithChannelButton(sock, from, `✅ Mode changé en : *${botPrivé ? "PUBLIC 🔓" : "PRIVÉ 🔒"}*`);
  }
});

