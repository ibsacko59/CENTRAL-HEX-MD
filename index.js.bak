// ==================== BROADCAST ====================
this.commands.set("bc", {
  name: "bc",
  description: "Broadcast à tous les groupes",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const text = args.join(" ");
    if (!text) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .bc [message]");
    }

    await sendWithChannelButton(sock, from, "📢 Broadcast en cours...");

    try {
      const groups = await sock.groupFetchAllParticipating();
      let count = 0;
      for (const [gid] of Object.entries(groups)) {
        try {
          await sock.sendMessage(gid, { text: `📢 *BROADCAST*\n\n${text}\n\n> 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇` });
          count++;
          await new Promise(r => setTimeout(r, 800));
        } catch (e) {}
      }
      await sendWithChannelButton(sock, from, `✅ Broadcast envoyé à ${count} groupes.`);
    } catch (err) {
      await sendWithChannelButton(sock, from, `❌ Erreur broadcast: ${err.message}`);
    }
  }
});

this.commands.set("broadcast", {
  name: "broadcast",
  description: "Alias de bc",
  execute: async (sock, msg, args) => {
    return this.commands.get("bc").execute(sock, msg, args);
  }
});

// ==================== ADMINLIST ====================
this.commands.set("adminlist", {
  name: "adminlist",
  description: "Liste des admins du groupe",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const metadata = await getGroupMetadata(sock, from);
    const admins = metadata.participants.filter(p => p.admin === "admin" || p.admin === "superadmin");

    let text = `👑 *LISTE DES ADMINS*\n\n`;
    const mentions = [];
    for (const admin of admins) {
      const role = admin.admin === "superadmin" ? "👑 Super Admin" : "🛡️ Admin";
      text += `${role}: @${admin.id.split("@")[0]}\n`;
      mentions.push(admin.id);
    }
    text += `\n📊 Total: ${admins.length} admin(s)`;
    text += `\n\n> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`;

    await sendWithChannelButton(sock, from, text, mentions);
  }
});

// ==================== PURGEGHOST ====================
this.commands.set("purgeghost", {
  name: "purgeghost",
  description: "Purge les membres inactifs",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const metadata = await getGroupMetadata(sock, from);
    const groupData = global.activityTracker?.get(from) || {};
    const now = Date.now();
    const inactiveDays = 7;
    const inactive = [];

    for (const p of metadata.participants) {
      if (p.admin) continue;
      const lastActivity = groupData[p.id];
      if (!lastActivity || (now - lastActivity) > inactiveDays * 86400000) {
        inactive.push(p.id);
      }
    }

    if (inactive.length === 0) {
      return await sendWithChannelButton(sock, from, "✅ Aucun fantôme détecté ! Tous les membres ont été actifs récemment.");
    }

    await sendWithChannelButton(sock, from,
      `👻 *PURGE FANTÔMES*\n\n📊 ${inactive.length} membre(s) inactif(s) détecté(s)\n⏳ Purge en cours...`
    );

    let purged = 0;
    for (const uid of inactive) {
      try {
        await sock.groupParticipantsUpdate(from, [uid], "remove");
        purged++;
        await new Promise(r => setTimeout(r, 500));
      } catch (e) {}
    }

    await sendWithChannelButton(sock, from,
      `✅ *PURGE TERMINÉE*\n\n👻 ${purged} fantôme(s) purgé(s) sur ${inactive.length}`
    );
  }
});

// ==================== ANTITAG ====================
this.commands.set("antitag", {
  name: "antitag",
  description: "Anti tag tous",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const option = args[0]?.toLowerCase();
    if (!option || !["on", "off"].includes(option)) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .antitag on/off");
    }

    if (!global.antitagGroups) global.antitagGroups = new Map();
    global.antitagGroups.set(from, option === "on");

    await sendWithChannelButton(sock, from,
      `🏷️ *ANTITAG* ${option === "on" ? "ACTIVÉ ✅" : "DÉSACTIVÉ ❌"}\n\nProtection contre les mentions de masse`
    );
  }
});

