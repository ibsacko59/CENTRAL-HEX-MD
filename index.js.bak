this.commands.set("delsudo", {
  name: "delsudo",
  description: "Retirer un utilisateur sudo",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Owner seulement");
    }

    const target = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0];
    if (!target) {
      return await sendWithChannelButton(sock, from, "❌ Mentionne l'utilisateur à retirer");
    }

    if (global.sudoUsers) {
      global.sudoUsers = global.sudoUsers.filter(u => u !== target);
    }

    await sendWithChannelButton(sock, from,
      `✅ @${target.split("@")[0]} retiré des sudo !`,
      [target]
    );
  }
});

