        }
      }
    });

    // ==================== COMMANDE SUSPEND ====================
    this.commands.set("suspend", {
      name: "suspend",
      execute: async (sock, message, args) => {
        try {
          if (!message.key.remoteJid.endsWith('@g.us')) {
            return;
          }

          const groupId = message.key.remoteJid;
          const sender = message.key.participant || message.key.remoteJid;
          const botId = sock.user.id;

          const groupMetadata = await getGroupMetadata(sock, groupId);
          const participants = groupMetadata.participants;

          // Vérifier si l'expéditeur est admin
          const senderParticipant = participants.find(p => p.id === sender);
          const isSenderAdmin = senderParticipant && ['admin', 'superadmin'].includes(senderParticipant.admin);

          if (!isSenderAdmin) {
            console.log(`🚫 ${sender} n'est pas admin - suspension refusée`);
            return;
          }

          // Vérifier si le bot est admin
          const botParticipant = participants.find(p => p.id === botId);
          const isBotAdmin = botParticipant && ['admin', 'superadmin'].includes(botParticipant.admin);

          if (!isBotAdmin) {
            await sock.sendMessage(sender, { 
              text: '❌ Le bot doit être administrateur pour suspendre des membres.\n\nPour rendre le bot admin :\n1. Ouvrez les infos du groupe\n2. Cliquez sur "Modifier les paramètres du groupe"\n3. Ajoutez le bot comme administrateur'
            });
            console.log(`⚠️ Bot non-admin dans ${groupId}`);
            return;
          }

          // Récupérer la mention
          const mentioned = message.message?.extendedTextMessage?.contextInfo?.mentionedJid;
          if (!mentioned || mentioned.length === 0) {
            await sock.sendMessage(sender, { 
              text: '❌ Veuillez mentionner l\'utilisateur à suspendre.\nExemple: .suspend @user 30m spam' 
            });
            return;
          }

          const targetUser = mentioned[0];

          if (targetUser === botId) {
            await sock.sendMessage(sender, { text: '❌ Impossible de suspendre le bot.' });
            return;
          }

          if (targetUser === sender) {
            await sock.sendMessage(sender, { text: '❌ Vous ne pouvez pas vous suspendre vous-même.' });
            return;
          }

          // Vérifier si la cible est admin
          const targetParticipant = participants.find(p => p.id === targetUser);
          const isTargetAdmin = targetParticipant && ['admin', 'superadmin'].includes(targetParticipant.admin);

          if (isTargetAdmin) {
            await sock.sendMessage(sender, { text: '❌ Impossible de suspendre un administrateur du groupe.' });
            return;
          }

          // Parser la durée
          const timeArg = args[1];
          if (!timeArg) {
            await sock.sendMessage(sender, { 
              text: '❌ Veuillez spécifier une durée.\nExemple: 30m, 1h, 2j' 
            });
            return;
          }

          const timeMatch = timeArg.match(/^(\d+)([smhjd])$/i);
          if (!timeMatch) {
            await sock.sendMessage(sender, { 
              text: '❌ Format de temps invalide. Utilisez: 30m, 1h, 2j, etc.' 
            });
            return;
          }

          const timeValue = parseInt(timeMatch[1]);
          const timeUnit = timeMatch[2].toLowerCase();
          const cause = args.slice(2).join(' ') || 'Non spécifiée';

          let durationMs;
          switch(timeUnit) {
            case 's': durationMs = timeValue * 1000; break;
            case 'm': durationMs = timeValue * 60 * 1000; break;
            case 'h': durationMs = timeValue * 60 * 60 * 1000; break;
            case 'j': case 'd': durationMs = timeValue * 24 * 60 * 60 * 1000; break;
            default: durationMs = 0;
          }

          const endDate = new Date(Date.now() + durationMs);
          const untilDate = endDate.toLocaleString('fr-FR', { 
            day: '2-digit', month: '2-digit', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
          });

          console.log(`✅ SUSPENSION: ${targetUser} par ${sender} pour ${durationMs}ms (${cause})`);

          // Message public avec l'effet transféré
          const suspendMessage = `
┏━━❖ 𝚂𝚄𝚂𝙿𝙴𝙽𝚂𝙸𝙾𝙽 ❖━━┓
┃
┃ 👤 @${targetUser.split('@')[0]}
┃ 📍 Groupe: ${groupMetadata.subject}
┃ ⚠️ Cause: ${cause}
┃ ⏱️ Jusqu'au: ${untilDate}
┃
┗━━━━━━━━━━━━━━━━━━━┛

> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻𝙴-𝙷𝙴𝚇`;

          await sendWithChannelButton(sock, groupId, suspendMessage, [targetUser]);

          // Message privé
          const privateMessage = `ⓘ Vous avez été suspendu dans le groupe ${groupMetadata.subject}\nCause: ${cause}\nJusqu'au: ${untilDate}`;
          await sock.sendMessage(targetUser, { text: privateMessage }).catch(() => {});

          // Stocker la suspension
          if (!global.suspendedUsers) global.suspendedUsers = new Map();
          
          global.suspendedUsers.set(`${groupId}:${targetUser}`, {
            groupId, userId: targetUser, adminId: sender,
            startDate: new Date(), endDate: durationMs > 0 ? endDate : null,
            cause, permanent: durationMs === 0
          });

          // Fin automatique
          if (durationMs > 0) {
            setTimeout(async () => {
              if (global.suspendedUsers?.has(`${groupId}:${targetUser}`)) {
                global.suspendedUsers.delete(`${groupId}:${targetUser}`);
                await sendWithChannelButton(sock, groupId, 
                  `⏱️ Suspension de @${targetUser.split('@')[0]} terminée.`, [targetUser]);
              }
            }, durationMs);
          }
          
        } catch (error) {
          console.error('❌ Erreur suspend:', error);
          const sender = message?.key?.participant || message?.key?.remoteJid;
          if (sender) {
            await sock.sendMessage(sender, { text: `❌ Erreur: ${error.message}` }).catch(() => {});
          }
        }
      }
    });

