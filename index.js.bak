// ==================== GATE ====================
this.commands.set("gate", {
  name: "gate",
  description: "Portail owner",
  execute: async (sock, msg) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Accès refusé. Owner seulement.");
    }

    const uptimeMs = Date.now() - BOT_START_TIME;
    const h = Math.floor(uptimeMs / 3600000);
    const m = Math.floor((uptimeMs % 3600000) / 60000);
    const mem = Math.round(process.memoryUsage().rss / 1024 / 1024);

    await sendWithChannelButton(sock, from,
      `🚪 *PORTAIL OWNER - CENTRAL-HEX*\n\n` +
      `┌─────────────────\n` +
      `│ 🤖 Bot: CENTRAL-HEX\n` +
      `│ 👑 Owner: ${config.ownerNumber}\n` +
      `│ ⏱️ Uptime: ${h}h ${m}m\n` +
      `│ 💾 RAM: ${mem} MB\n` +
      `│ 🔓 Mode: ${botPrivé ? "Public" : "Privé"}\n` +
      `│ 📋 Commandes actives\n` +
      `│ 🔰 Sudo: ${(global.sudoUsers || []).length}\n` +
      `│ 👥 Extra Owners: ${(global.extraOwners || []).length}\n` +
      `└─────────────────\n\n` +
      `> 𝚙𝚘𝚠𝚎𝚛𝚎𝚍 𝚋𝚢 𝙲𝙴𝙽𝚃𝚁𝙰𝙻-𝙷𝙴𝚇`
    );
  }
});

// ==================== NSFW ====================
this.commands.set("nsfw", {
  name: "nsfw",
  description: "Activer/désactiver le contenu NSFW",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const option = args[0]?.toLowerCase();
    if (!option || !["on", "off"].includes(option)) {
      return await sendWithChannelButton(sock, from, "❌ Usage: .nsfw on/off");
    }

    if (!global.nsfwGroups) global.nsfwGroups = new Map();
    global.nsfwGroups.set(from, option === "on");

    await sendWithChannelButton(sock, from,
      `🔞 *NSFW* ${option === "on" ? "ACTIVÉ ✅" : "DÉSACTIVÉ ❌"}\n\n${option === "on" ? "⚠️ Contenu adulte autorisé dans ce groupe." : "✅ Contenu adulte désactivé."}`
    );
  }
});

// ==================== FREEZE ====================
this.commands.set("freeze", {
  name: "freeze",
  description: "Geler un membre (mute temporaire)",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;
    const sender = msg.key.participant || msg.key.remoteJid;

    if (!from.endsWith("@g.us")) {
      return await sendWithChannelButton(sock, from, "❌ Groupe uniquement");
    }

    const isAdmin = await isAdminInGroup(sock, from, sender);
    if (!isAdmin && !isOwner(sender)) {
      return await sendWithChannelButton(sock, from, "❌ Admins seulement");
    }

    const target = msg.message?.extendedTextMessage?.contextInfo?.mentionedJid?.[0];
    if (!target) {
      return await sendWithChannelButton(sock, from, "❌ Mentionne la personne à geler\nEx: .freeze @user 5m");
    }

    const duration = parseInt(args[1]) || 5;
    const unit = args[2]?.toLowerCase() || "m";
    let durationMs = duration * 60000;
    if (unit === "s") durationMs = duration * 1000;
    else if (unit === "h") durationMs = duration * 3600000;

    if (!global.frozenUsers) global.frozenUsers = new Map();
    global.frozenUsers.set(`${from}:${target}`, Date.now() + durationMs);

    await sendWithChannelButton(sock, from,
      `🧊 *FREEZE*\n\n@${target.split("@")[0]} est gelé pour ${duration}${unit} !\nIl ne peut plus envoyer de messages.`,
      [target]
    );

    setTimeout(() => {
      if (global.frozenUsers) global.frozenUsers.delete(`${from}:${target}`);
      sock.sendMessage(from, { text: `🧊 @${target.split("@")[0]} est dégelé !`, mentions: [target] }).catch(() => {});
    }, durationMs);
  }
});

// ==================== GHOSTTAG ====================
this.commands.set("ghosttag", {
  name: "ghosttag",
  description: "Tagger discrètement un membre",
  execute: async (sock, msg, args) => {
    const from = msg.key.remoteJid;

    if (!from.endsWith("@g.us")) return;

    const metadata = await getGroupMetadata(sock, from);
    const mentions = metadata.participants.map(p => p.id);
    const text = args.join(" ") || "\u200B";

    await sock.sendMessage(from, {
      text: text,
      mentions
    });
  }
});

